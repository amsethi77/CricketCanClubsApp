{
  "name": "cricketcanclubs-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.20",
    "expo-constants": "~58.0.13",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:android-test": "npx eas-cli@latest build -p android --profile preview",
    "build:ios": "npx eas-cli@latest build -p ios --profile production",
    "build:android": "npx eas-cli@latest build -p android --profile production",
    "submit:ios": "npx eas-cli@latest submit -p ios --profile production",
    "submit:android": "npx eas-cli@latest submit -p android --profile production"
  },
  "private": true
}
