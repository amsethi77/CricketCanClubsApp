# Copy this file to .env (next to README.md) and fill in your own values.
# .env is ignored by git. Never commit real keys.
# See README.md -> "Subscriptions and plans" -> "Switching on Stripe payments".

# Stripe secret key (use sk_test_... while testing)
STRIPE_SECRET_KEY=
# Recurring price ids from the Stripe dashboard
STRIPE_PRICE_SUPER=
STRIPE_PRICE_PREMIUM=
# Webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Address people use to open the app, e.g. https://cricketcanclubs.ca
APP_BASE_URL=http://localhost:8090
