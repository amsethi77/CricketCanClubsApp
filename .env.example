# Copy this file to .env (in the project folder, next to the app folder) and fill in your own values.
# .env is ignored by git. Never commit real keys.
# See MD/README.md -> "Subscriptions and plans" and "Reading handwritten scorecards automatically".

# --- Reading handwritten scorecard photos with AI ---
# FREE: key from https://aistudio.google.com/apikey (Google account, no card)
GEMINI_API_KEY=
# Optional, paid instead of Gemini: key from https://console.anthropic.com
# ANTHROPIC_API_KEY=

# --- Stripe payments for the Pro plan ---
# Stripe secret key (use sk_test_... while testing)
STRIPE_SECRET_KEY=
# Recurring price ids from the Stripe dashboard: Pro $9 every month and Pro $90 every year
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Default plan for users without an explicit admin or Stripe plan.
# Use pro during development; set to free before going live.
CRICKETCLUBAPP_DEFAULT_PLAN=pro
# Address people use to open the app, e.g. https://cricketcanclubs.ca
APP_BASE_URL=http://localhost:8090

# What "RO" means in HOW OUT on your paper scorecards: "retired out" (default) or "run out".
SCORECARD_RO_MEANS=retired out
